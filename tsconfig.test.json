{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["server/src/**/*.ts", "testing/**/*.ts", "vitest.config.mts"],
  "exclude": ["node_modules", "**/out/**"]
}
