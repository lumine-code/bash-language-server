{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["dom", "es2022"],
    "module": "node16",
    "moduleResolution": "node16",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022"
  }
}
